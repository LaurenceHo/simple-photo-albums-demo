    "@vuelidate/validators": "^2.0.4",
    "dompurify": "^3.4.17",
    "embla-carousel-vue": "^8.6.0",
    "exifreader": "^4.54.0",
    "mapbox-gl": "^3.34.2",
    "pinia": "4.1.0",
    "primevue": "^5.0.4",
    "radash": "^12.1.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "0.6.1",
    "vue": "^3.5.45",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
