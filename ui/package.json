    "@vue/tsconfig": "0.9.1",
    "embla-carousel": "^8.6.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "31.0.0",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
