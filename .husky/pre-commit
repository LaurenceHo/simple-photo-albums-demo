#!/usr/bin/env sh
#
# Block commits containing private infrastructure identifiers.
#
# `master` is mirrored to a public repo after every merge, so real domains, bucket names,
# worker names and account IDs must never be committed - not in source, not in docs, not in
# code comments. The repo being private is not protection; anything merged is published.
#
# The patterns live in `.private-strings`, which is gitignored on purpose: if the list of
# forbidden values were committed, the hook would leak exactly what it exists to protect.
# Copy `.private-strings.example` to `.private-strings` and fill in your own values.
#
# With no `.private-strings` present the hook is a no-op, so a fresh clone or CI checkout
# is never blocked by a file it cannot have.

PATTERNS_FILE=".private-strings"
[ -f "$PATTERNS_FILE" ] || exit 0

# Added lines only. Removing a leaked string must stay possible, so the deleted side of
# the diff is not checked. The `+++ b/path` header survives this filter deliberately: a
# filename containing a private identifier should be caught too.
ADDED=$(git diff --cached --diff-filter=ACMR -U0 | sed -n 's/^+//p')
[ -n "$ADDED" ] || exit 0

# Normalise exactly as .github/workflows/sync-demo.yaml does, so the two halves of this
# control cannot disagree about what a pattern is:
#   tr -d '\r'  - a CRLF file leaves a trailing CR on every pattern, which then matches
#                 nothing. The hook would report success while protecting zero values.
#   grep -vE    - drops comments and blank lines, including indented ones. A whitespace-only
#                 line is a regex that matches almost everything and would block every commit.
CLEAN_PATTERNS=$(tr -d '\r' <"$PATTERNS_FILE" | grep -vE '^[[:space:]]*(#|$)') || true
if [ -z "$CLEAN_PATTERNS" ]; then
  echo "  $PATTERNS_FILE has no usable patterns - refusing to pass." >&2
  exit 1
fi

HIT=0
while IFS= read -r pattern || [ -n "$pattern" ]; do
  # grep exits 0=match, 1=no match, >=2=error. `if grep ...` would read an invalid regex
  # as "no match" and silently disable that pattern for every future commit, so the status
  # is captured and an error is treated as a failure.
  rc=0
  printf '%s\n' "$ADDED" | grep -q -i -E -- "$pattern" || rc=$?
  # Print a prefix only. Echoing the whole pattern would put the value into terminal
  # scrollback and CI logs.
  prefix=$(printf '%s' "$pattern" | cut -c1-4)
  case "$rc" in
    0) echo "  matched forbidden pattern starting: $prefix..." >&2; HIT=1 ;;
    1) ;;
    *) echo "  pattern starting '$prefix...' is not a valid regex - refusing to pass." >&2; HIT=1 ;;
  esac
done <<EOF
$CLEAN_PATTERNS
EOF

if [ "$HIT" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked: staged changes contain a private infrastructure identifier.

This repository is public. Replace the value with a placeholder before committing -
`example.com`, `<prod-bucket>`, `<db-name>`, `<worker-name>`. Real values belong in
GitHub environment secrets and in `wrangler.toml`, which is gitignored.

If this is a false positive:
  git commit --no-verify

MSG
  exit 1
fi
